        function openExamModal(examId = null) {
            const modal = document.getElementById('modal-exam');
            const globalWrapper = document.getElementById('exam-global-checkbox-wrapper');
            
            if (isOwnerMode) {
                globalWrapper.classList.remove('hidden');
            } else {
                globalWrapper.classList.add('hidden');
            }

            if (examId) {
                const exam = studentData.exams.find(e => e.id === examId);
                if (!exam) return;
                document.getElementById('modal-exam-title').textContent = 'Editar Prova';
                document.getElementById('exam-edit-id').value = exam.id;
                document.getElementById('exam-subject').value = exam.subject;
                document.getElementById('exam-date').value = exam.date;
                document.getElementById('exam-time').value = exam.time;
                document.getElementById('exam-topics').value = exam.topics || '';
                document.getElementById('exam-status').value = exam.status;
                document.getElementById('exam-is-global').checked = !!exam.isGlobal;
            } else {
                document.getElementById('modal-exam-title').textContent = 'Agendar Nova Prova';
                document.getElementById('exam-edit-id').value = '';
                document.getElementById('exam-subject').value = '';
                document.getElementById('exam-date').value = new Date().toISOString().split('T')[0];
                document.getElementById('exam-time').value = '08:00';
                document.getElementById('exam-topics').value = '';
                document.getElementById('exam-status').value = 'Estudando';
                document.getElementById('exam-is-global').checked = isOwnerMode;
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function saveExam() {
            const id = document.getElementById('exam-edit-id').value;
            const subject = document.getElementById('exam-subject').value.trim();
            const date = document.getElementById('exam-date').value;
            const time = document.getElementById('exam-time').value;
            const topics = document.getElementById('exam-topics').value.trim();
            const status = document.getElementById('exam-status').value;
            const isGlobal = isOwnerMode && document.getElementById('exam-is-global').checked;

            if (!subject || !date) {
                showToast('Preencha a matéria e a data da prova.', 'error');
                return;
            }

            const examObj = {
                id: id || 'exam-' + Date.now(),
                subject,
                date,
                time: time || '08:00',
                topics,
                status,
                isGlobal
            };

            if (id) {
                const idx = studentData.exams.findIndex(e => e.id === id);
                if (idx !== -1) studentData.exams[idx] = examObj;
            } else {
                studentData.exams.push(examObj);
            }

            if (isOwnerMode && isGlobal) {
                const gIdx = ownerConfig.baseExams.findIndex(e => e.id === examObj.id);
                if (gIdx !== -1) ownerConfig.baseExams[gIdx] = examObj;
                else ownerConfig.baseExams.push(examObj);
                saveOwnerConfigLocally();
            }

            saveStudentData();
            renderExams();
            closeModal('modal-exam');
            showToast('Horário de prova salvo com sucesso!');
        }

        function quickChangeExamStatus(id, newStatus) {
            const exam = studentData.exams.find(e => e.id === id);
            if (exam) {
                exam.status = newStatus;
                saveStudentData();
                renderExams();
                showToast(`Status atualizado para "${newStatus}".`);
            }
        }

        function deleteExam(id) {
            studentData.exams = studentData.exams.filter(e => e.id !== id);
            if (isOwnerMode) {
                ownerConfig.baseExams = ownerConfig.baseExams.filter(e => e.id !== id);
                saveOwnerConfigLocally();
            }
            saveStudentData();
            renderExams();
            showToast('Prova removida da lista.');
        }

