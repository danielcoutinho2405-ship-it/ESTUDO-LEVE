                    </div>
                `;
                return;
            }

            container.innerHTML = list.map(exam => {
                const statusBadge = {
                    'Estudando': 'bg-amber-50 text-amber-700 border-amber-200',
                    'Revisado': 'bg-emerald-50 text-emerald-700 border-emerald-200',
                    'Prova Feita': 'bg-slate-100 text-slate-600 border-slate-200'
                }[exam.status] || 'bg-slate-100 text-slate-700';

                return `
                    <div class="p-4 rounded-xl border border-slate-200 hover:border-emerald-300 bg-white transition flex flex-col sm:flex-row sm:items-center justify-between gap-3">
