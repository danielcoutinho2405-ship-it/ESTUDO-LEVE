    <!-- ===================================================================== -->
    <!-- APPLICATION LOGIC (VANILLA JS + GEMINI AI + LOCALSTORAGE)             -->
    <!-- ===================================================================== -->
    <script>
        // Storage Keys (Estudo Leve + migration support from older keys)
        const STORAGE_KEY_STUDENT = 'estudoleve_student_data_v1';
        const STORAGE_KEY_OWNER_OVERRIDE = 'estudoleve_owner_override_v1';
        const LEGACY_STORAGE_KEY_STUDENT = 'missao803_student_data_v1';
        const LEGACY_STORAGE_KEY_OWNER = 'missao803_owner_override_v1';

        // Global State
        let ownerConfig = {};
        let studentData = {};
        let isOwnerMode = false;
        let currentTab = 'dashboard';
        let activeSubjectId = null;
        let currentExamFilter = 'all';
        let trailSearchQuery = '';
        let questionFilters = {}; // { [modId]: 'all' | 'pending' | 'wrong' }
        let expandedSummaryContext = { subId: null, modId: null };

        // AI Generator State
        let aiContext = {
            subId: null,
            modId: null,
            sourceMode: 'summary', // 'summary' | 'custom'
            generatedQuestions: []
        };

        // Pomodoro State
        let pomoMode = 'focus'; // 'focus' (25m) | 'break' (5m)
        let pomoSecondsLeft = 25 * 60;
        let pomoInterval = null;
        let pomoRunning = false;

        // Initialize App
        document.addEventListener('DOMContentLoaded', () => {
            loadOwnerConfig();
            loadStudentData();
            applySiteBranding();
            renderAll();
            lucide.createIcons();

            // ESC key closes any open modal
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeAllModals();
                }
            });
        });

        // 1. Load Owner Base Config (Embedded JSON + Local Owner Edits if any)
        function loadOwnerConfig() {
            const rawScript = document.getElementById('owner-default-config').textContent;
            const embeddedConfig = JSON.parse(rawScript);
            const savedOverride = localStorage.getItem(STORAGE_KEY_OWNER_OVERRIDE) || localStorage.getItem(LEGACY_STORAGE_KEY_OWNER);
            
            if (savedOverride) {
                try {
                    ownerConfig = JSON.parse(savedOverride);
                    if (!ownerConfig.siteTitle || ownerConfig.siteTitle === 'Missão 803') {
                        ownerConfig.siteTitle = embeddedConfig.siteTitle;
                        ownerConfig.siteSubtitle = embeddedConfig.siteSubtitle;
                    }
                } catch (e) {
                    ownerConfig = embeddedConfig;
                }
            } else {
                ownerConfig = embeddedConfig;
            }
        }

        function saveOwnerConfigLocally() {
            localStorage.setItem(STORAGE_KEY_OWNER_OVERRIDE, JSON.stringify(ownerConfig));
        }

        // 2. Load Student Private Data (Merged cleanly with Owner's base items)
        function loadStudentData() {
            const saved = localStorage.getItem(STORAGE_KEY_STUDENT) || localStorage.getItem(LEGACY_STORAGE_KEY_STUDENT);
            if (saved) {
                try {
                    studentData = JSON.parse(saved);
                } catch (e) {
                    studentData = createInitialStudentData();
                }
            } else {
                studentData = createInitialStudentData();
            }

            if (!studentData.profile) {
                studentData.profile = { name: 'Estudante', goal: 'Estudando com leveza e foco!', focusMinutes: 0 };
            }
            if (studentData.profile.name === 'Estudante 803') {
                studentData.profile.name = 'Estudante';
            }
            if (typeof studentData.profile.focusMinutes !== 'number') {
                studentData.profile.focusMinutes = 0;
            }

            // Smart sync with owner's global items without erasing student's progress/notes
            syncGlobalItemsWithStudent();
            saveStudentData();
        }

        function createInitialStudentData() {
            return {
                profile: {
                    name: 'Estudante',
                    goal: 'Estudando com leveza e foco!',
                    focusMinutes: 0
                },
                exams: JSON.parse(JSON.stringify(ownerConfig.baseExams || [])),
                subjects: JSON.parse(JSON.stringify(ownerConfig.baseSubjects || []))
            };
        }

        function syncGlobalItemsWithStudent() {
            const examMap = new Map(studentData.exams.map(e => [e.id, e]));
            (ownerConfig.baseExams || []).forEach(gExam => {
                if (!examMap.has(gExam.id)) {
                    studentData.exams.push(JSON.parse(JSON.stringify(gExam)));
                } else {
                    const localExam = examMap.get(gExam.id);
                    localExam.subject = gExam.subject;
                    localExam.date = gExam.date;
                    localExam.time = gExam.time;
                    localExam.topics = gExam.topics;
                    localExam.isGlobal = true;
                }
            });

            const subMap = new Map(studentData.subjects.map(s => [s.id, s]));
            (ownerConfig.baseSubjects || []).forEach(gSub => {
                if (!subMap.has(gSub.id)) {
                    studentData.subjects.push(JSON.parse(JSON.stringify(gSub)));
                } else {
                    const localSub = subMap.get(gSub.id);
                    localSub.name = gSub.name;
                    localSub.isGlobal = true;
                    const localModIds = new Set((localSub.modules || []).map(m => m.id));
                    (gSub.modules || []).forEach(gMod => {
                        if (!localModIds.has(gMod.id)) {
                            localSub.modules.push(JSON.parse(JSON.stringify(gMod)));
                        }
                    });
                }
            });

            if (!activeSubjectId && studentData.subjects.length > 0) {
                activeSubjectId = studentData.subjects[0].id;
            }
        }

        function saveStudentData() {
            localStorage.setItem(STORAGE_KEY_STUDENT, JSON.stringify(studentData));
            updateKPIs();
        }

        // 3. UI Branding & Header Info
        function applySiteBranding() {
            document.getElementById('header-site-title').textContent = ownerConfig.siteTitle || 'Estudo Leve';
            document.getElementById('header-site-subtitle').textContent = ownerConfig.siteSubtitle || '';
            document.title = `${ownerConfig.siteTitle || 'Estudo Leve'} — Plataforma de Estudos com IA`;

            const name = studentData.profile.name || 'Estudante';
            const goal = studentData.profile.goal || 'Clique para definir seu nome e meta';
            document.getElementById('student-display-name').textContent = name;
            document.getElementById('student-display-goal').textContent = goal;
            document.getElementById('student-avatar-initials').textContent = name.trim().charAt(0).toUpperCase() || 'E';
        }

        // 4. Pomodoro Focus Timer + Web Audio API Chime
        function playGentleChime() {
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                const ctx = new AudioCtx();
                const notes = [523.25, 659.25, 783.99];
                notes.forEach((freq, i) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, ctx.currentTime + i * 0.14);
                    gain.gain.setValueAtTime(0.08, ctx.currentTime + i * 0.14);
                    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + i * 0.14 + 0.5);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(ctx.currentTime + i * 0.14);
                    osc.stop(ctx.currentTime + i * 0.14 + 0.5);
                });
            } catch (e) {}
        }

        function updatePomodoroDisplay() {
            const mins = Math.floor(pomoSecondsLeft / 60).toString().padStart(2, '0');
            const secs = (pomoSecondsLeft % 60).toString().padStart(2, '0');
            document.getElementById('pomo-timer-display').textContent = `${mins}:${secs}`;
        }

        function togglePomodoro() {
            const btn = document.getElementById('pomo-toggle-btn');
            if (pomoRunning) {
                clearInterval(pomoInterval);
                pomoRunning = false;
                btn.innerHTML = `<i data-lucide="play" class="w-3.5 h-3.5"></i>`;
                lucide.createIcons();
            } else {
                pomoRunning = true;
                btn.innerHTML = `<i data-lucide="pause" class="w-3.5 h-3.5"></i>`;
                lucide.createIcons();
                pomoInterval = setInterval(() => {
                    if (pomoSecondsLeft > 0) {
                        pomoSecondsLeft--;
                        updatePomodoroDisplay();
                    } else {
                        clearInterval(pomoInterval);
                        pomoRunning = false;
                        btn.innerHTML = `<i data-lucide="play" class="w-3.5 h-3.5"></i>`;
                        lucide.createIcons();
                        playGentleChime();
                        if (pomoMode === 'focus') {
                            studentData.profile.focusMinutes = (studentData.profile.focusMinutes || 0) + 25;
                            saveStudentData();
                            showToast('Sessão de 25 min concluída! +25 min registrados.');
                            switchPomodoroMode('break');
                        } else {
                            showToast('Pausa finalizada! Pronto para focar novamente.');
                            switchPomodoroMode('focus');
                        }
                    }
                }, 1000);
            }
        }

        function resetPomodoro() {
            clearInterval(pomoInterval);
            pomoRunning = false;
            pomoSecondsLeft = pomoMode === 'focus' ? 25 * 60 : 5 * 60;
            updatePomodoroDisplay();
            const btn = document.getElementById('pomo-toggle-btn');
            btn.innerHTML = `<i data-lucide="play" class="w-3.5 h-3.5"></i>`;
            lucide.createIcons();
        }

        function switchPomodoroMode(forcedMode = null) {
            clearInterval(pomoInterval);
            pomoRunning = false;
            pomoMode = forcedMode || (pomoMode === 'focus' ? 'break' : 'focus');
            pomoSecondsLeft = pomoMode === 'focus' ? 25 * 60 : 5 * 60;
            const badge = document.getElementById('pomo-mode-badge');
            if (pomoMode === 'focus') {
                badge.textContent = 'Foco';
                badge.className = 'text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30 transition cursor-pointer';
            } else {
                badge.textContent = 'Pausa';
                badge.className = 'text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-300 hover:bg-amber-500/30 transition cursor-pointer';
            }
            updatePomodoroDisplay();
            const btn = document.getElementById('pomo-toggle-btn');
            btn.innerHTML = `<i data-lucide="play" class="w-3.5 h-3.5"></i>`;
            lucide.createIcons();
        }

        // 5. Navigation Tabs
        function switchTab(tabName) {
            currentTab = tabName;
            ['dashboard', 'trilha', 'guia'].forEach(t => {
                const section = document.getElementById(`view-${t}`);
                const btn = document.getElementById(`tab-btn-${t}`);
                if (t === tabName) {
                    section.classList.remove('hidden');
                    btn.classList.add('tab-active');
                    btn.classList.remove('text-slate-600', 'hover:bg-slate-100');
                } else {
                    section.classList.add('hidden');
                    btn.classList.remove('tab-active');
                    btn.classList.add('text-slate-600', 'hover:bg-slate-100');
                }
            });
            lucide.createIcons();
        }

        // 6. Render All Components
        function renderAll() {
            updateKPIs();
            renderExams();
            renderAnnouncements();
            renderSubjectsTabs();
            renderActiveSubjectWorkspace();
            lucide.createIcons();
        }

        // 7. KPIs Calculation
        function updateKPIs() {
            let totalModules = 0;
            let completedModules = 0;
            let totalQuestions = 0;
            let correctQuestions = 0;
            let totalSummaries = 0;
            let totalVideos = 0;

            studentData.subjects.forEach(sub => {
                (sub.modules || []).forEach(mod => {
                    totalModules++;
                    if (mod.completed) completedModules++;
                    if (mod.summary && mod.summary.trim().length > 0) totalSummaries++;
                    totalVideos += (mod.videos || []).length;
                    (mod.questions || []).forEach(q => {
                        totalQuestions++;
                        if (q.correct === true) correctQuestions++;
                    });
                });
            });

            const percent = totalModules === 0 ? 0 : Math.round((completedModules / totalModules) * 100);
            document.getElementById('kpi-progress-percent').textContent = `${percent}%`;
            document.getElementById('kpi-modules-count').textContent = `${completedModules}/${totalModules} etapas`;
            document.getElementById('kpi-progress-bar').style.width = `${percent}%`;

            document.getElementById('kpi-questions-total').textContent = totalQuestions;
            document.getElementById('kpi-questions-accuracy').textContent = totalQuestions > 0 
                ? `${correctQuestions} acerto(s) marcado(s)` 
                : 'Gere questões com IA na Trilha';

            document.getElementById('kpi-summaries-count').textContent = totalSummaries;
            document.getElementById('kpi-videos-count').textContent = totalVideos;

            const focusMins = studentData.profile.focusMinutes || 0;
            document.getElementById('kpi-focus-minutes').innerHTML = `<i data-lucide="timer" class="w-3.5 h-3.5"></i> ${focusMins} min de foco registrados`;

            // Next Exam Countdown
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const upcoming = studentData.exams
                .filter(e => e.status !== 'Prova Feita' && e.date)
                .map(e => ({ ...e, dateObj: new Date(e.date + 'T00:00:00') }))
                .filter(e => e.dateObj >= today)
                .sort((a, b) => a.dateObj - b.dateObj);

            const nextExamContainer = document.getElementById('kpi-next-exam-content');
            if (upcoming.length > 0) {
                const next = upcoming[0];
                const diffDays = Math.ceil((next.dateObj - today) / (1000 * 60 * 60 * 24));
                const dayLabel = diffDays === 0 ? 'É HOJE!' : diffDays === 1 ? 'Amanhã' : `Em ${diffDays} dias`;
                nextExamContainer.innerHTML = `
                    <div class="text-xl font-display font-bold truncate">${escapeHTML(next.subject)}</div>
                    <div class="text-xs text-emerald-300 font-semibold mt-1 flex items-center gap-1.5">
                        <span>${dayLabel}</span> • <span>${formatDateBR(next.date)} às ${escapeHTML(next.time)}</span>
                    </div>
                `;
            } else {
                nextExamContainer.innerHTML = `
                    <div class="text-lg font-display font-bold text-slate-200">Tudo em dia!</div>
                    <div class="text-xs text-slate-400 mt-1">Nenhuma prova futura pendente</div>
                `;
            }
            lucide.createIcons();
        }

        // 8. Exams Schedule Render & Logic
        function filterExams(status) {
