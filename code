                            </div>
                            <div class="text-xs font-semibold text-emerald-700 flex items-center gap-3">
                                <span class="flex items-center gap-1"><i data-lucide="calendar" class="w-3.5 h-3.5"></i> ${formatDateBR(exam.date)}</span>
                                <span class="flex items-center gap-1"><i data-lucide="clock" class="w-3.5 h-3.5"></i> ${escapeHTML(exam.time)}</span>
                            </div>
