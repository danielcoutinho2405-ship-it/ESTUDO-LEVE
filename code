                                ${exam.isGlobal ? `<span class="text-[10px] font-bold uppercase tracking-wider bg-slate-900 text-emerald-400 px-2 py-0.5 rounded-md">Oficial Turma</span>` : ''}
                                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full border ${statusBadge}">${escapeHTML(exam.status)}</span>
