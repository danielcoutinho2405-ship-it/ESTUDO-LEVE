                list = list.filter(e => e.status === currentExamFilter);
            }

            if (list.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10 px-4 border-2 border-dashed border-slate-200 rounded-2xl">
                        <p class="text-sm font-semibold text-slate-600">Nenhuma prova encontrada neste filtro.</p>
                        <p class="text-xs text-slate-400 mt-1">Clique em "Adicionar Prova" acima para registrar seu cronograma.</p>
